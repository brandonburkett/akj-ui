---
import './dojo-notice.css';
import { storage } from '@/lib/storage';
import type { DojoNoticeData } from '@/data/dojo-notice';

interface Props {
  notice: DojoNoticeData;
}

const { notice } = Astro.props;
const color = notice.color ?? 'olive';
const shortText = notice.shortText ?? notice.text;

// built here so the `akj:` prefix has exactly one definition, the inline script
// below cannot import from a bundle
const storageKey = storage.key('dojo-notice');
---

<div class:list={['dojo-notice', `dojo-notice-${color}`]} data-notice-id={notice.id}>
  <a class="dojo-notice-link" href={notice.href}>
    <span class="dojo-notice-long">{notice.text}</span>
    <span class="dojo-notice-short">{shortText}</span>
  </a>
  <button class="dojo-notice-close" type="button" aria-label="Dismiss notice" hidden>
    <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
      <path
        d="M3 3 L13 13 M13 3 L3 13"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"></path>
    </svg>
  </button>
</div>

{/* Inline and immediately after the markup, so the decision lands before first paint */}
<script
  is:inline
  define:vars={{ noticeId: notice.id, start: notice.start, end: notice.end, storageKey }}
>
  (function () {
    const el = document.querySelector('.dojo-notice');
    if (!el) {
      return;
    }

    // date-only strings parse as UTC, date-time without an offset parses as local
    const now = Date.now();
    let live = now >= Date.parse(`${start}T00:00:00`) && now <= Date.parse(`${end}T23:59:59.999`);

    // dates first, so storage is only touched while a notice is actually running
    if (live) {
      try {
        live = window.localStorage.getItem(storageKey) !== noticeId;
      } catch {
        // storage blocked, keep showing it, the close button stays hidden
      }
    }

    if (!live) {
      el.remove();
    }
  })();
</script>
