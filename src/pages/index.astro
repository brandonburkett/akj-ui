---
import StandardLayout from '@/layouts/StandardLayout.astro';
import BelowFold from '@/components/BelowFold/BelowFold.astro';
import Footer from '@/components/Footer/Footer.astro';
import FullScreenParallaxImage from '@/components/FullScreenParallaxImage/FullScreenParallaxImage.astro';
import HomeHero from '@/components/HomeHero/HomeHero.astro';
import HomeAbout from '@/components/HomeAbout/HomeAbout.astro';
import HomeImageBand from '@/components/HomeImageBand/HomeImageBand.astro';

// structured data (schema.org) for local SEO + LLM/agent consumption
import schema from '@/data/local-business-schema.json';

import imgEnbu from './home-images/1920-mjer-enbu-2025.webp';

const title = 'Traditional Japanese Swordsmanship';
const desc =
  'The Austin Komei Jyuku dojo teaches Yamauchi-Ha Muso Jikiden Eishin-ryu Iaijutsu under Sekiguchi Komei Sensei in Austin, Texas.';
---

<StandardLayout title={title} desc={desc} path={Astro.url.pathname}>
  <FullScreenParallaxImage backgroundImgSrc={imgEnbu.src} scrollTargetId="main" parallaxSpeed={5}>
    <HomeHero />
  </FullScreenParallaxImage>

  <BelowFold role="main" id="main" tabindex="-1">
    <HomeAbout />
    <HomeImageBand />
    <Footer />
  </BelowFold>

  <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
</StandardLayout>
